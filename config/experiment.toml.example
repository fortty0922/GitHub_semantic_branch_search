[corpus.topics]
min_count = 30
max_df = 0.05
min_assoc = 0.3
min_lift = 4.0
min_margin = 2.0
min_seed_assoc = 0.05
max_new_per_round = 100
max_rounds = 3
collapse_min_topics = 12
collapse_threshold = 0.4
collapse_num_perm = 128

[corpus.clean]
inline_code_max_words = 3

[corpus.dedup]
min_tokens = 20
shingle_size = 5
num_perm = 128
threshold = 0.9
min_english_ratio = 0.5
max_group_size = 5
mirror_share = 0.5
keep_star_ratio = 10.0

[corpus.labels]
target_precision = 0.9
min_support = 50
cv_folds = 5
seed = 20261126
other_min_topics = 3
max_features = 50000
min_df = 2
C = 1.0

[corpus.labels.expansion]
min_count = 20
min_purity = 0.9
exclude = []

[corpus.split]
test_fraction = 0.1
sources = ["topic", "topic_ext", "awesome", "manual"]
seed = 20261126

[paths]
test_set = "data/test_set.json"
manual_labels = "data/manual/labels.csv"
manual_exclude = "data/manual/exclude.csv"

[crawler.domain]
target_per_domain = 20000
max_topic_queries = 40
